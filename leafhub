-- ลูปการทำงานหลัก (รวมกระบวนการตกปลาและขายเข้าด้วยกันอย่างเป็นระบบ)
task.spawn(function()
    while true do
        if autoFishEnabled then
            -- 1. โยนแม่เหล็ก
            local castArgs = {
                0.9980157909133613,
                vector.create(-0.003327461890876293, -0.21495194733142853, -0.9766190052032471)
            }
            pcall(function()
                castRemote:FireServer(unpack(castArgs))
            end)
            
            -- 2. รอเวลา 9 วินาทีให้แม่เหล็กทำงาน
            task.wait(9)
            
            if autoFishEnabled then
                -- 3. เล่นมินิเกมดึงปลาขึ้นมาจนจบ
                pcall(function()
                    reelRemote:FireServer(unpack({false}))
                    task.wait(0.5)
                    reelRemote:FireServer(unpack({true}))
                end)
                
                -- 4. เช็กจนกว่าจะมีของขึ้นมาถืออยู่ที่มือจริงๆ (ป้องกันวาร์ประหว่างหลอดวิ่ง)
                local character = player.Character
                local hasItem = false
                local waitTimeout = 0
                
                repeat
                    task.wait(0.2)
                    waitTimeout = waitTimeout + 0.2
                    if character then
                        for _, item in ipairs(character:GetChildren()) do
                            if item:IsA("Tool") and item.Name ~= "Magnet" then
                                hasItem = true
                                break
                            end
                        end
                    end
                until hasItem or waitTimeout >= 3
                
                task.wait(0.4)
                
                -- 5. หากเปิดปุ่ม "ขายอัตauto" ไว้ ให้วาร์ปไปขายทันทีหลังตกเสร็จครบ 1 รอบ
                if autoSellEnabled and autoFishEnabled then
                    executeSell()
                    task.wait(0.5)
                end
            end
        else
            task.wait(0.4)
        end
    end
end)
